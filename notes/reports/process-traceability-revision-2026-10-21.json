{
  "datum": "2026-10-21",
  "zadatak": "Omogućiti praćenje podrijetla podataka, pojedinačnog računa i zbirnog rezultata u cijeloj knjizi, prema potpunoj priloženoj autorskoj uputi.",
  "polaziste": "Aktualno radno stablo sa svim prethodnim autorskim izmjenama; usporedba prema snimci prije ovoga zahvata, ne prema Git HEAD-u.",
  "opseg": "Izmijenjena su poglavlja 01–18 i Dodatak A. Predgovor i ostali dodaci nisu zahtijevali nove izmjene u ovom prolazu. Statusi poglavlja, sve kontrolne datoteke comprehensive-review i zajednički registri ostali su netaknuti.",
  "poglavlja": [
    {
      "poglavlje": 1,
      "datoteka": "chapters/01-zasto-statistika.qmd",
      "izmjene": "Objašnjena su pravila nastanka simulirane populacije. Ponderirani prosjek portala izveden je iz brojanja, a interakcija sa Simpsonovim obrascem označena kao namjerno konstruiran prikaz.",
      "sha256_prije": "4704831d1ea2bfec47329bf4950dea80473af61dd01787e04833b37674a703fd",
      "sha256_poslije": "e579b7f797cd99d0d30a2b20b1617f4d433569240b397dbe21c1c076d0bd134c"
    },
    {
      "poglavlje": 2,
      "datoteka": "chapters/02-mjerenje-i-dizajn.qmd",
      "izmjene": "Prikazana su tri početna zapisa instrumenta i račun za jednu osobu prije i nakon okretanja niječne tvrdnje. Odvojeni su konstruirani odgovori i deterministički prikaz konfundiranja.",
      "sha256_prije": "821e588f71428a13d81d808d456221d72032f6739204a1f19b4d9119cf4080aa",
      "sha256_poslije": "256599473264e92c3ed24f74d2a05437cd6a0da9926c371862683c4a889d467f"
    },
    {
      "poglavlje": 3,
      "datoteka": "chapters/03-kako-brojke-zavode.qmd",
      "izmjene": "Konstruirana tablica pokazuje kako pojedinačni ishodi ulaze u različite nazivnike. Prikaz margine pogreške jasno je odvojen od simulacije stvarnih anketnih odgovora.",
      "sha256_prije": "85444bc0ff61391f32bff4a514737e88b1c09684f3bb0ee1f3ae0e2b4fe83036",
      "sha256_poslije": "28ecc3a24076291f648f7a4d1fc170794591738d1f7baf0d14a3d48e68b42a3a"
    },
    {
      "poglavlje": 4,
      "datoteka": "chapters/04-sazimanje-podataka.qmd",
      "izmjene": "Dva zapisa pokazuju spajanje mjesečnih i godišnjih podataka. Objašnjeni su nedostupni podaci, generator nastavne ankete, zbroj i nazivnik sredine, podrezivanje, varijanca i logaritmiranje istih osoba.",
      "sha256_prije": "9228d584507d6acbee72a3183026e9637587144ddf156a94491fc4632f24bdb0",
      "sha256_poslije": "cfb4e6db28e54f250f9e536e025370dd93eaeafd2a4249131ae100a106bb03b6"
    },
    {
      "poglavlje": 5,
      "datoteka": "chapters/05-vizualizacija.qmd",
      "izmjene": "Na konkretnom naslovu prikazana je priprema riječi za brojanje. Dodani su pojedinačni parovi iz Anscombeovih skupova, a podaci interakcije odvojeni od empirijskih primjera.",
      "sha256_prije": "cebd398a7ec53897882d40dcfc5dc8a560df3b8a8d63929d8793abf32190583f",
      "sha256_poslije": "5802438c8f9b2123b953c23452378f30ff2ab3de6703aac6a5d0c491975177a8"
    },
    {
      "poglavlje": 6,
      "datoteka": "chapters/06-povezanost.qmd",
      "izmjene": "Jedan par opažanja povezan je s kovarijancom i standardiziranjem. Prikazan je račun vezanih rangova te objašnjena pravila nastanka Simpsonovih skupina i oblaka korelacije.",
      "sha256_prije": "4157d8408c67717c35d410e210672c2e2e0b70afa6e1a16f017f3a09dc15e168",
      "sha256_poslije": "8270877091b70815d8b26aae9a1f4a7e1881d429c55e75336c1d62916862edd6"
    },
    {
      "poglavlje": 7,
      "datoteka": "chapters/07-vjerojatnost.qmd",
      "izmjene": "Prikazani su prvi ishodi novčića i kumulativni udio. Kod odabira nakon niza uspjeha vidljivi su uvjet, nazivnici i izostavljanja. Binarni ishodi povezani su s brojem otvaranja u jednoj i u 20 000 kampanja.",
      "sha256_prije": "ae25c22d8e02a9def923dec0a8543c392de5cdbc34e04b0e7001fbeb0d39887d",
      "sha256_poslije": "23d106a606a32741c526743ad6a76a97b3638bd6706d465ad8bf75a541cd66c0"
    },
    {
      "poglavlje": 8,
      "datoteka": "chapters/08-uzorkovanje.qmd",
      "izmjene": "Prvih pet zapisa povezano je sa sredinom jednog uzorka. Razlikuju se novo izvlačenje iz populacije, promjene veličine uzorka, izbor s vraćanjem u interakciji i izračun raspršenosti kroz ponavljanja.",
      "sha256_prije": "dbaed8e73af732412e5f2f99d60b7418d2a8be6f503f048ba239bc3e3bd23b51",
      "sha256_poslije": "7bf127bf693652e698c38d4126922e4cd2c258210bc702965ccea47d00150124"
    },
    {
      "poglavlje": 9,
      "datoteka": "chapters/09-procjena.qmd",
      "izmjene": "Interval je rastavljen na sredinu, standardnu pogrešku i marginu. Obuhvat ima jasan nazivnik. Početni uzorak stoji uz jedan bootstrap uzorak s izvornim indeksima i rezultatom iz svih 60 izvučenih zapisa.",
      "sha256_prije": "a9c7689732eb53feb63808d1001e4b6df0f1eb7dbff74c05032504fd40b86610",
      "sha256_poslije": "f46b766e6c0c731dbc25fd4a98a43ea608f987e174bb226acf4ae6e9d28ebbce"
    },
    {
      "poglavlje": 10,
      "datoteka": "chapters/10-logika-testiranja.qmd",
      "izmjene": "Brojnosti i zbrojevi prethode opaženoj razlici. Isti zapisi prikazani su prije i poslije prve permutacije. Razlikuju se unutarnja preslagivanja, vanjski novi uzorci, lažna odbacivanja i snaga.",
      "sha256_prije": "f2643fa2f792bb6ec968bf7011f4cbc74881e41dbe6e595530438ff56e1ef916",
      "sha256_poslije": "9fedfc0b9277438dd297e0b5728559bd249ecfe2c74d053713f32c4d2ddcb2bf"
    },
    {
      "poglavlje": 11,
      "datoteka": "chapters/11-velicina-ucinka-i-snaga.qmd",
      "izmjene": "Veličina učinka vraćena je populacijskim skupinama. Prikazane su prve simulirane studije prije odabira značajnih, svi nazivnici i isključenja te jedna cijela studija iz planiranja uzorka. Dodatna decimala sprječava dvosmislenost oko praga 0,05.",
      "sha256_prije": "2afdcaf862a16d9222246d7d02ee894046e7dcd47f0377de8d28216f82e0398e",
      "sha256_poslije": "475124481e16eb10801a32fe077d871e524ecf03cf06a901c36b827b5cd40b8a"
    },
    {
      "poglavlje": 12,
      "datoteka": "chapters/12-kriza-i-obnova.qmd",
      "izmjene": "Tri laboratorija povezuju skupne sredine s razlikama. Objašnjene su težine, standardiziranje i objedinjavanje istih 17 laboratorija. Skriveni račun ponovno izračunava sirovu i standardiziranu REML procjenu iz lokalno provjerenih sažetaka.",
      "sha256_prije": "c6a3a222ed1aa6a07b269947851a2d390a150907cd752cad512e94ec1464d707",
      "sha256_poslije": "3dded3d26904f376471c95da4c269cc7c90a22a5df330d63ad55ee27ef35e9b8"
    },
    {
      "poglavlje": 13,
      "datoteka": "chapters/13-kategoricki-podaci.qmd",
      "izmjene": "Prikazana su glavna brojanja, očekivanja, referentne raspodjele i spajanje kategorija istih 800 osoba. Obnovljen je cijeli odjeljak o malim očekivanim frekvencijama s četiri scenarija, izabranom tablicom, brojem odbacivanja, neprimjenjivim ponavljanjima i pet Fisherovih rasporeda.",
      "sha256_prije": "061b7271c10968bf5ea082db1d37caf0ae23fdb386f2b61cf7252b60f6e0ffce",
      "sha256_poslije": "d354a98db5091f819a40487ca022b59340049780e9186ea2705ac7ed51544709"
    },
    {
      "poglavlje": 14,
      "datoteka": "chapters/14-dvije-grupe.qmd",
      "izmjene": "Odvojeni su novi uzorak od 120 osoba, zasebnih 60 parova i model interakcije. Skupni zbrojevi vode prema Welchovu računu, a tri para prema promjenama i računima rangova.",
      "sha256_prije": "3f689182a31c29113199f3de7527edf1216108a8dbb88b05629b28e9504ebc03",
      "sha256_poslije": "ef6c07045fec886cf717ff2f3839bb3a09d085bc60255bdedeab054635c8bb37"
    },
    {
      "poglavlje": 15,
      "datoteka": "chapters/15-vise-grupa.qmd",
      "izmjene": "Jedno ponavljanje obiteljskih usporedbi pokazuje što se broji kroz 2 000 pokusa. Navedeni su preklapanje skupina i nazivnici. Skupne sredine povezane su sa zbrojevima kvadrata i Tukeyevom usporedbom; ispravljen je smjer opisa kontrasta tisak minus TV.",
      "sha256_prije": "250edb93162165d710d9d60bc3a3faf20691e200016ceb4874763707859d49f8",
      "sha256_poslije": "2fc2414c8cfd1cfe85165b9dd896be3ffa67bbe334e38fca8f877e06d779ff2e"
    },
    {
      "poglavlje": 16,
      "datoteka": "chapters/16-regresija.qmd",
      "izmjene": "Opažanja, predviđanja i reziduali prikazani su prije tumačenja modela. Objašnjeni su prilagođena predviđanja, generator interakcije, R² i odvajanje 150 osoba za učenje od 2 000 osoba za provjeru. Jedan kvadrat pogreške vodi prema RMSE-u.",
      "sha256_prije": "c5af6e8bf3a41c4b6ed5a5e28586d70eb63f4055907a99726258ede2f33b5145",
      "sha256_poslije": "8858d6088bfd396615753fc739297195a9f26d52faf4a510e2ef83eaf930d9b9"
    },
    {
      "poglavlje": 17,
      "datoteka": "chapters/17-doba-algoritama.qmd",
      "izmjene": "Model rezultata interakcije odvojen je od opaženih tekstnih oznaka i kalibrirane vjerojatnosti. Tri konkretna koderska zapisa vode prema tablici zabune na istih 272 zapisa, uz izričite nazivnike stopa.",
      "sha256_prije": "813645aa7187de6c92f58499eb04ded14bfccda0dd55f7a840363801168045ce",
      "sha256_poslije": "7d7b59a9779b73ee1f5d784e12976c3adfd53d6f67d50b261ad31dce12754b97"
    },
    {
      "poglavlje": 18,
      "datoteka": "chapters/18-vase-prvo-istrazivanje.qmd",
      "izmjene": "Naglašeno je vraćanje istim 300 osobama. Tri opažanja pokazuju predviđanja obaju modela i vezu reziduala s intervalom. Završni tekstni opis jasno prelazi s 272 zapisa na svih 2 698 i razdvaja putove nastanka oznaka.",
      "sha256_prije": "1ebaef5842235ab8ea9a0692c14443b6948480493487c6f829cf1d20de30dbd6",
      "sha256_poslije": "fd3d567714231e5918b164160e1eb92af94aaae8a357fbadc3afdfe6270df820"
    }
  ],
  "dodatak_a": "Razlikovani su ručno konstruirani primjeri i generirana anketa. Na četiri prljava zapisa objašnjeni su rekodiranje, NA i nazivnik. Razlikovan je podskup instrumenta od cijelog primjera u 2. poglavlju. Ispravljen je opis histograma te uklonjena implikacija da tekstni paket sadrži stranačku pripadnost.",
