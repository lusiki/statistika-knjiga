      "dio": 1,
      "dioLabel": "DIO I: STATISTIČKO MIŠLJENJE",
      "firstSentence": "Konfundirajuća varijabla je varijabla koja je povezana i s pretpostavljenim uzrokom i s ishodom, pa dio opažene veze među njima potječe od nje, a ne od djelovanja uzroka na ishod.",
      "mentions": 2
    },
    {
