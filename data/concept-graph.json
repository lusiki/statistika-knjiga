    {
      "id": "standardna-devijacija",
      "term": "Standardna devijacija",
      "chapter": "chapters/04-sazimanje-podataka.qmd",
      "chapterTitle": "Sažimanje podataka",
      "dio": 2,
      "dioLabel": "DIO II: OPISIVANJE PODATAKA",
      "firstSentence": "Standardna devijacija je korijen varijance, pa raspršenost izražava u istim jedinicama kao izmjerene vrijednosti.",
