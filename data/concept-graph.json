    },
    {
      "id": "asimetrija",
      "term": "Asimetrija",
      "chapter": "chapters/04-sazimanje-podataka.qmd",
      "chapterTitle": "Sažimanje podataka",
      "dio": 2,
      "dioLabel": "DIO II: OPISIVANJE PODATAKA",
      "firstSentence": "Asimetrija je mjera nesimetričnosti raspodjele, pozitivna kada je rep raspodjele okrenut prema većim vrijednostima.",
