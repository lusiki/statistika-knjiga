renv/activate.R whitespace=-blank-at-eol

# Podatkovne snimke nose zabiljezen kontrolni zbroj u data/katalog.yml, pa im
# krajevi redaka moraju biti isti u svakoj kopiji repozitorija. Bez ovoga bi
# core.autocrlf=true pri odjavi na Windowsu pretvorio LF u CRLF, promijenio
# bajtove i time i MD5, i provjera bi pala u svjezoj kopiji iako u datoteci
# nista nije pogrijeseno. Snimke pise scripts/build-data-snapshots.R uvijek s
# LF-om, a ovo pravilo cuva to kroz git.
data/*.csv text eol=lf
data/*.LICENCA.md text eol=lf
data/LICENCA-generirani-podaci.md text eol=lf

# P3-EUROSTAT checksums the retained query, retrieval and reconciliation JSON
# and stores the official API responses byte for byte. Keep generated metadata
# at LF on every platform and treat raw source responses as opaque bytes.
data/eurostat_drustvo/*.json text eol=lf
data/eurostat_drustvo/*.md text eol=lf
data/eurostat_drustvo/raw/*.json binary

# P3-EVIDENCE12 retains a checksummed, non-identifying editorial evidence
# table outside data/ because it is not a reader dataset or catalogue package.
notes/reports/p3-evidence12-rrr-lab-effects.csv text eol=lf
