{
  "text-color": "#33322A",
  "background-color": "#F3EFE6",
  "line-number-color": "#9B9789",
  "line-number-background-color": null,

  "text-styles": {
    "Other":         { "text-color": "#33322A", "bold": false, "italic": false, "underline": false },
    "Attribute":     { "text-color": "#40566B" },
    "SpecialString": { "text-color": "#8A6212" },
    "Annotation":    { "text-color": "#9B9789", "italic": true },
    "Function":      { "text-color": "#16150F", "bold": false },
    "String":        { "text-color": "#8A6212" },
    "ControlFlow":   { "text-color": "#16150F", "bold": true },
    "Operator":      { "text-color": "#6E6C61" },
    "Error":         { "text-color": "#8A2A12", "bold": true },
    "BaseN":         { "text-color": "#40566B" },
    "Alert":         { "text-color": "#8A2A12", "bold": true },
    "Variable":      { "text-color": "#33322A" },
    "BuiltIn":       { "text-color": "#16150F" },
    "Extension":     { "text-color": "#33322A" },
    "Preprocessor":  { "text-color": "#6E6C61" },
    "Information":   { "text-color": "#9B9789", "italic": true },
    "VerbatimString":{ "text-color": "#8A6212" },
    "Warning":       { "text-color": "#8A6212", "italic": true },
    "Documentation": { "text-color": "#9B9789", "italic": true },
    "Import":        { "text-color": "#40566B" },
    "Char":          { "text-color": "#8A6212" },
    "DataType":      { "text-color": "#40566B" },
    "Float":         { "text-color": "#40566B" },
    "Comment":       { "text-color": "#9B9789", "italic": true },
    "CommentVar":    { "text-color": "#9B9789", "italic": true },
    "Constant":      { "text-color": "#40566B" },
    "SpecialChar":   { "text-color": "#8A6212" },
    "DecVal":        { "text-color": "#40566B" },
    "Keyword":       { "text-color": "#16150F", "bold": true }
  }
}
