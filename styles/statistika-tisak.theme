{
  "_comment": [
    "statistika-tisak.theme — bojanje sintakse za CRNO-BIJELI tiskani blok.",
    "",
    "Ista struktura kao styles/statistika.theme, ali svaka vrijednost je siva.",
    "Razlike se nose SVJETLINOM i rezom, ne tonom: ključne riječi su crne i",
    "podebljane, brojke i tipovi tamnosivi, nizovi srednjesivi, komentari",
    "svijetlosivi i kurzivni. Blok se tiska jednobojno, pa bi bilo koja boja",
    "ovdje na papiru postala nasumična siva i izgubila razliku.",
    "",
    "Vidi DESIGN.md, načelo 3 („crno-bijelo prvo\")."
  ],

  "text-color": "#2B2A26",
  "background-color": "#F4F3F0",
  "line-number-color": "#9A9892",
  "line-number-background-color": null,

  "text-styles": {
    "Other":          { "text-color": "#2B2A26", "bold": false, "italic": false, "underline": false },
    "Attribute":      { "text-color": "#4A4945" },
    "SpecialString":  { "text-color": "#5C5B56" },
    "Annotation":     { "text-color": "#9A9892", "italic": true },
    "Function":       { "text-color": "#16150F" },
    "String":         { "text-color": "#5C5B56" },
    "ControlFlow":    { "text-color": "#16150F", "bold": true },
    "Operator":       { "text-color": "#6E6C61" },
    "Error":          { "text-color": "#16150F", "bold": true, "underline": true },
    "BaseN":          { "text-color": "#4A4945" },
    "Alert":          { "text-color": "#16150F", "bold": true, "underline": true },
    "Variable":       { "text-color": "#2B2A26" },
    "BuiltIn":        { "text-color": "#16150F" },
    "Extension":      { "text-color": "#2B2A26" },
    "Preprocessor":   { "text-color": "#6E6C61" },
    "Information":    { "text-color": "#9A9892", "italic": true },
    "VerbatimString": { "text-color": "#5C5B56" },
    "Warning":        { "text-color": "#4A4945", "italic": true },
    "Documentation":  { "text-color": "#9A9892", "italic": true },
    "Import":         { "text-color": "#4A4945" },
    "Char":           { "text-color": "#5C5B56" },
    "DataType":       { "text-color": "#4A4945" },
    "Float":          { "text-color": "#4A4945" },
    "Comment":        { "text-color": "#9A9892", "italic": true },
    "CommentVar":     { "text-color": "#9A9892", "italic": true },
    "Constant":       { "text-color": "#4A4945" },
    "SpecialChar":    { "text-color": "#5C5B56" },
    "DecVal":         { "text-color": "#4A4945" },
    "Keyword":        { "text-color": "#16150F", "bold": true }
  }
}
