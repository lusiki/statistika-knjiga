{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bookwright/shared/conventions.schema.json",
  "title": "Book structural conventions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "labels",
    "opener_exempt",
    "widget_policy",
    "bands",
    "structure",
    "intellectual_architecture"
  ],
  "properties": {
    "note": {
      "type": "string"
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opener",
        "figure_prefix",
        "definition",
        "callout_wild",
        "callout_ai",
        "callout_error",
        "exercise_tiers"
      ],
      "properties": {
        "opener": {
          "type": "string"
        },
        "figure_prefix": {
          "type": "string"
        },
        "definition": {
          "type": "string"
        },
        "callout_wild": {
          "type": "string"
        },
        "callout_ai": {
          "type": "string"
        },
        "callout_error": {
          "type": "string"
        },
        "exercise_tiers": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "callout_applied": {
          "type": "string",
          "deprecated": true
        },
        "callout_empirical": {
          "type": "string",
          "deprecated": true
        },
        "exercise": {
          "type": "string",
          "deprecated": true
        }
      }
    },
    "opener_exempt": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "widget_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory",
        "required_chapters",
        "exempt_chapters",
        "static_twin_required",
        "logical_pair_count"
      ],
      "properties": {
        "inventory": {
          "type": "string"
        },
        "required_chapters": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "exempt_chapters": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "static_twin_required": {
          "type": "boolean"
        },
        "logical_pair_count": {
          "type": "integer",
          "minimum": 1
        },
        "note": {
          "type": "string"
        }
      }
    },
    "bands": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definitions_per_chapter",
        "figures_per_chapter",
        "callout_wild_per_chapter",
        "callout_ai_per_chapter",
        "exercises_min"
      ],
      "properties": {
        "definitions_per_chapter": {
          "$ref": "#/$defs/integerBand"
        },
        "figures_per_chapter": {
          "$ref": "#/$defs/integerBand"
        },
        "callout_wild_per_chapter": {
          "$ref": "#/$defs/integerBand"
        },
        "callout_ai_per_chapter": {
          "$ref": "#/$defs/integerBand"
        },
        "exercises_min": {
          "type": "integer",
          "minimum": 0
        },
        "callout_applied_per_chapter": {
          "$ref": "#/$defs/integerBand",
          "deprecated": true
        },
        "callout_empirical_per_chapter": {
          "$ref": "#/$defs/integerBand",
          "deprecated": true
        }
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opener_class",
        "summary_label",
        "tail_labels",
        "exercise_parent_label",
        "catalogue_chapters",
        "deep_dive_chapters",
        "word_chapter_max",
        "evenness_cv_max",
        "element_words",
        "coda_min_ratio_to_median",
        "scaffold_min_prose_words",
        "essay",
        "catalogue"
      ],
      "properties": {
        "note": {
          "type": "string"
        },
        "opener_class": {
          "type": "string"
        },
        "vodic_label": {
          "type": "string",
          "description": "Legacy reader-compatible label. New checks use opener_class."
        },
        "summary_label": {
          "type": "string"
        },
        "tail_labels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "exercise_parent_label": {
          "type": "string"
        },
        "tail_sections_excluded_from_body_rhythm": {
          "type": "boolean"
        },
        "catalogue_chapters": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "deep_dive_chapters": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "deep_dive_note": {
          "type": "string"
        },
        "word_chapter_max": {
          "type": "integer",
          "minimum": 1
        },
        "evenness_cv_max": {
          "type": "number",
          "minimum": 0
        },
        "element_words": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "callout",
            "figure",
            "ojs",
            "table"
          ],
          "properties": {
            "callout": {
              "type": "integer",
              "minimum": 0
            },
            "figure": {
              "type": "integer",
              "minimum": 0
            },
            "ojs": {
              "type": "integer",
              "minimum": 0
            },
            "table": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "coda_min_ratio_to_median": {
          "type": "number",
          "minimum": 0
        },
        "scaffold_min_prose_words": {
          "type": "integer",
          "minimum": 0
        },
        "essay": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sections",
            "pars",
            "words",
            "ratio_max",
            "vodic_pars",
            "par_words"
          ],
          "properties": {
            "sections": {
              "$ref": "#/$defs/integerBand"
            },
            "pars": {
              "$ref": "#/$defs/integerBand"
            },
            "words": {
              "$ref": "#/$defs/integerBand"
            },
            "ratio_max": {
              "type": "number",
              "minimum": 1
            },
            "vodic_pars": {
              "$ref": "#/$defs/integerBand"
            },
            "par_words": {
              "$ref": "#/$defs/integerBand"
            },
            "allow_h3": {
              "type": "boolean"
            }
          }
        },
        "catalogue": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entry_pars",
            "entry_words",
            "frame_pars"
          ],
          "properties": {
            "entry_pars": {
              "$ref": "#/$defs/integerBand"
            },
            "entry_words": {
              "$ref": "#/$defs/integerBand"
            },
            "frame_pars": {
              "$ref": "#/$defs/integerBand"
            },
            "allow_h3": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "intellectual_architecture": {
      "$ref": "#/$defs/intellectualArchitecture"
    }
  },
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "placementRole": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locations",
        "role"
      ],
      "properties": {
        "locations": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "intellectualArchitecture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "decision",
        "ratified_at",
        "decision_evidence",
        "register_items",
        "authority_boundary",
        "claim_registry",
        "lifecycle_registry",
        "thread_registry",
        "ethics_registry",
        "data_science_registry"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "status": {
          "const": "ratified"
        },
        "decision": {
          "const": "G-A2a"
        },
        "ratified_at": {
          "type": "string",
          "pattern": "^2026-08-04$"
        },
        "decision_evidence": {
          "type": "string",
          "minLength": 1
        },
        "register_items": {
          "type": "array",
          "minItems": 22,
          "maxItems": 22,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "authority_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chapter_prose_edit_authorised",
            "chapter_spine_ratification_authorised",
            "terminology_ratification_authorised",
            "assessment_contract_authorised",
            "data_package_selection_or_promotion_authorised",
            "chapter_17_prerequisite_resolution_authorised",
            "new_numbered_chapter_authorised",
            "new_central_widget_authorised",
            "new_callout_type_authorised"
          ],
          "properties": {
            "chapter_prose_edit_authorised": {"const": false},
            "chapter_spine_ratification_authorised": {"const": false},
            "terminology_ratification_authorised": {"const": false},
            "assessment_contract_authorised": {"const": false},
            "data_package_selection_or_promotion_authorised": {"const": false},
            "chapter_17_prerequisite_resolution_authorised": {"const": false},
            "new_numbered_chapter_authorised": {"const": false},
            "new_central_widget_authorised": {"const": false},
            "new_callout_type_authorised": {"const": false}
          }
        },
        "claim_registry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "population_reach_is_independent_of_claim_type",
            "dimensions",
            "placement_rule",
            "audit_questions",
            "audit_question_placements",
            "honest_sentence_standard",
            "sensitivity_standard",
            "poll_reading_card"
          ],
          "properties": {
            "population_reach_is_independent_of_claim_type": {"const": true},
            "dimensions": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "items": {"type": "object"}
            },
            "placement_rule": {"type": "object"},
            "audit_questions": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "items": {"type": "object"}
            },
            "audit_question_placements": {"type": "object"},
            "honest_sentence_standard": {"type": "object"},
            "sensitivity_standard": {"type": "object"},
            "poll_reading_card": {"type": "object"}
          }
        },
        "lifecycle_registry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stages",
            "introduced_in",
            "preface_role",
            "stage_emphasis_is_cumulative_and_nonexclusive",
            "part_roles",
            "exclusions"
          ],
          "properties": {
            "stages": {
              "type": "array",
              "minItems": 9,
              "maxItems": 9,
              "uniqueItems": true,
              "items": {"type": "string"}
            },
            "introduced_in": {"type": "string"},
            "preface_role": {"type": "string"},
            "stage_emphasis_is_cumulative_and_nonexclusive": {"const": true},
            "part_roles": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "items": {"type": "object"}
            },
            "exclusions": {"$ref": "#/$defs/nonEmptyStringArray"}
          }
        },
        "thread_registry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope_control",
            "threads"
          ],
          "properties": {
            "scope_control": {"type": "object"},
            "threads": {
              "type": "array",
              "minItems": 7,
              "maxItems": 7,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "label_hr",
                  "plant",
                  "develop",
                  "harvest",
                  "exclusions"
                ],
                "properties": {
                  "id": {"type": "string"},
                  "label_hr": {"type": "string"},
                  "plant": {"$ref": "#/$defs/placementRole"},
                  "develop": {"$ref": "#/$defs/placementRole"},
                  "harvest": {"$ref": "#/$defs/placementRole"},
                  "exclusions": {"$ref": "#/$defs/nonEmptyStringArray"}
                }
              }
            }
          }
        },
        "ethics_registry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ordinary_practice_scope",
            "dataset_passport_questions",
            "not_confined_to",
            "evidence_objects"
          ],
          "properties": {
            "ordinary_practice_scope": {"$ref": "#/$defs/nonEmptyStringArray"},
            "dataset_passport_questions": {"$ref": "#/$defs/nonEmptyStringArray"},
            "not_confined_to": {"$ref": "#/$defs/nonEmptyStringArray"},
            "evidence_objects": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {"type": "object"}
            }
          }
        },
        "data_science_registry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "fifth_promise",
            "integration",
            "attention_budget",
            "activities",
            "boundary_rules",
            "technical_topics_out_of_scope",
            "simulation_and_empirical_roles",
            "data_design_policy"
          ],
          "properties": {
            "role": {"const": "delivery_mechanism_for_the_four_promises"},
            "fifth_promise": {"const": false},
            "integration": {"type": "object"},
            "attention_budget": {"type": "object"},
            "activities": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {"type": "object"}
            },
            "boundary_rules": {"$ref": "#/$defs/nonEmptyStringArray"},
            "technical_topics_out_of_scope": {"$ref": "#/$defs/nonEmptyStringArray"},
            "simulation_and_empirical_roles": {"type": "object"},
            "data_design_policy": {"type": "object"}
          }
        }
      }
    },
    "integerBand": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    }
  }
}
